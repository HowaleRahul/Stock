# =====================================================================
# F&O AI TRADING SYSTEM — ENVIRONMENT CONFIGURATION
# =====================================================================
# Copy this file to .env and insert your real credentials & settings.
# Never commit `.env` to Git!

# ---------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ---------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=127.0.0.1
API_KEY=replace_with_a_long_random_secret

# ---------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + TimescaleDB)
# ---------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_DB=trading_db
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_postgres_password@127.0.0.1:5432/trading_db

# ---------------------------------------------------------------------
# 3. F&O UNDERLYING INDICES (Indian Market Only)
# ---------------------------------------------------------------------
# Supported: NIFTY, BANKNIFTY, FINNIFTY, MIDCPNIFTY
TARGET_SYMBOLS=["NIFTY", "BANKNIFTY"]

# ---------------------------------------------------------------------
# 4. BROKER API SECRETS (NSE F&O Brokers)
# ---------------------------------------------------------------------
# Zerodha Kite (Primary NSE F&O Broker)
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# AngelOne SmartAPI (Alternative NSE F&O Broker)
ANGEL_API_KEY=your_angel_api_key_here

# Upstox (Alternative NSE F&O Broker)
UPSTOX_API_KEY=your_upstox_api_key_here

# ---------------------------------------------------------------------
# 5. OPTIONAL: DISTRIBUTED INFRASTRUCTURE
# ---------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
